{
  "name": "awesome-free-games-1000",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-catalog.mjs",
    "dev": "vite --host 127.0.0.1",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "check": "node scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run generate:catalog && npm run check && vite build && node scripts/validate.mjs --dist",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "verify": "npm run test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.2.2",
    "vite": "8.3.0"
  },
  "engines": { "node": ">=22.12.0" }
}
